{
  "title": "Project Genesis",
  "description": "Configure the generated project workspace.",
  "steps": [
    {
      "id": "project",
      "title": "Project Information",
      "description": "Basic information about the project.",
      "fields": [
        {
          "key": "PROJECT_NAME",
          "label": "Project Name",
          "type": "string",
          "required": true
        },
        {
          "key": "CLIENT_NAME",
          "label": "Client Name",
          "type": "string",
          "required": false
        },
        {
          "key": "PROJECT_DESCRIPTION",
          "label": "Project Description",
          "type": "multiline",
          "required": true
        },
        {
          "key": "TECH_STACK",
          "label": "Tech Stack",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "id": "generation-options",
      "title": "Generation Options",
      "description": "Choose optional project capabilities.",
      "fields": [
        {
          "key": "USE_DOCKER",
          "label": "Use Docker?",
          "type": "boolean",
          "required": true
        },
        {
          "key": "USE_DATABASE",
          "label": "Use a Database?",
          "type": "boolean",
          "required": true
        },
        {
          "key": "DATABASE",
          "label": "Database",
          "type": "select",
          "required": true,
          "options": [
            {
              "label": "PostgreSQL",
              "value": "postgres"
            },
            {
              "label": "SQLite",
              "value": "sqlite"
            },
            {
              "label": "SQL Server",
              "value": "sqlserver"
            },
            {
              "label": "None",
              "value": "none"
            }
          ]
        }
      ]
    }
  ]
}