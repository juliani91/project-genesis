[
  {
    "source": "README.md",
    "destination": "README.md",
    "mode": "render"
  },
  {
    "source": "CLAUDE.md",
    "destination": "CLAUDE.md",
    "mode": "render"
  },
  {
    "source": "Docs/ARCHITECTURE.md",
    "destination": "Docs/ARCHITECTURE.md",
    "mode": "render"
  },
  {
    "source": "Planning/STATE.md",
    "destination": "Planning/STATE.md",
    "mode": "render"
  },
  {
    "source": "Planning/Sprints/Requirements.md",
    "destination": "Planning/Sprints/Requirements.md",
    "mode": "render"
  },
  {
  "source": "copy-test.txt",
  "destination": "Content/copy-test.txt",
  "mode": "copy"
  },
  {
  "source": "Docker/Dockerfile",
  "destination": "Docker/Dockerfile",
  "mode": "render",
  "rules": [
    {
      "type": "condition",
      "variable": "USE_DOCKER",
      "equals": "true"
    }
  ]
},
{
  "source": "Database/PostgreSQL/README.md",
  "destination": "Database/PostgreSQL/README.md",
  "mode": "render",
  "rules": [
    {
      "type": "condition",
      "variable": "USE_DATABASE",
      "equals": "true"
    },
    {
      "type": "condition",
      "variable": "DATABASE",
      "equals": "postgres"
    }
  ]
}
]
