    "test:template-library": "tsx sandbox/template-library-expansion-test.ts",
    "test:package-install": "tsx sandbox/package-install-guidance-test.ts && tsx sandbox/local-template-info-command-test.ts",
    "genesis": "tsx cli/genesis.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
